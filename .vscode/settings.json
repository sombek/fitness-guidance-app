{
  "ruff.format.preview": false,
  "files.autoSave": "afterDelay",
  "editor.formatOnSave": true,
  "editor.fontLigatures": "'cv01', 'cv02', 'cv06', 'ss01', 'zero', 'cv14', 'cv27','cv31','ss10'",
  "editor.fontWeight": "450",
  "editor.fontFamily": "'Fira Code', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "editor.fontSize": 15,
  "editor.semanticHighlighting.enabled": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontFamily": "'Fira Code', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "terminal.integrated.fontLigatures.featureSettings": "'cv01', 'cv02', 'cv06', 'ss01', 'zero', 'cv14', 'cv27','cv31','ss10'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "450",
  "python.venvPath": "${workspaceFolder}/venv",
  // formatters for different languages
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.sortImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  "python.analysis.packageIndexDepths": [
    {
      "name": "sqlalchemy",
      "depth": 2
    }
  ],
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "mypy-type-checker.args": [
    "--config-file=../mypy.ini"
  ],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.preferDaemon": false,
  "mypy-type-checker.cwd": "${workspaceFolder}/api",
  "application.experimental.rendererProfiling": false,
  "autopep8.importStrategy": "useBundled",
  "ruff.configuration": "ruff.toml",
  "cSpell.words": [
    "realestate",
    "rebl",
    "rega"
  ],
  "workbench.colorTheme": "Atom One Dark",
  "files.exclude": {
    "**/.mypy_cache": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    ".ruff*": true,
    ".run": true,
    ".dockerignore": true
  },
  "workbench.iconTheme": "vscode-icons",
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.pythonProjects": []
}